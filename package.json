{
  "name": "algorithms",
  "version": "1.0.0",
  "description": "Personal collection of algorithm and data-structure implementations, each with Jest tests.",
  "type": "module",
  "private": true,
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage:watch": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "exec": "tsx",
    "dev": "tsx watch",
    "repl": "tsx"
  },
  "author": "Tyler Rhodes",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
