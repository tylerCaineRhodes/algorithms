{
  "name": "algorithms",
  "version": "1.0.0",
  "description": "Personal collection of algorithm and data-structure implementations, each with Jest tests.",
  "type": "module",
  "private": true,
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage:watch": "jest --coverage --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "exec": "tsx",
    "dev": "tsx watch",
    "repl": "tsx"
  },
  "author": "Tyler Rhodes",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jest": "^29.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.68.0"
  }
}
